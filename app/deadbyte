def _db2_switchboard():
    import shutil
    import sys
    import unicodedata

    columns = shutil.get_terminal_size((120, 32)).columns
    width = min(max(columns - 1, 42), 132)
    left = [
        ('01', '☣', 'LIVE', 'Internet Archive'),
        ('02', '◈', 'LIVE', 'Open Library'),
        ('03', '▣', 'LIVE', 'Library of Congress'),
        ('04', '✎', 'LIVE', 'Wikisource'),
        ('05', '♜', 'LIVE', 'Project Gutenberg / Gutendex'),
        ('06', '▤', 'LIVE', 'Historical Newspapers / LOC'),
        ('15', '☠', 'FUTURE', 'SHADOW SLOT'),
        ('16', '◆', 'FUTURE', 'RESERVED BAY'),
    ]
    right = [
        ('07', '◷', 'LIVE', 'Wayback Machine'),
        ('08', '▥', 'LIVE', 'Common Crawl'),
        ('09', '⌘', 'LIVE', 'Archive-It'),
        ('10', '◇', 'PORTAL', 'Europeana (API key)'),
        ('11', '✦', 'FUSION', 'Six research engines'),
        ('12', '☠', 'VAULT', 'Saved sessions'),
        ('13', '⚙', 'HELP', 'HEXCODEX recipes'),
        ('14', '☣', 'FUSION', 'DEAD ARCHIVES // Sentence research'),
    ]

    def cells(s):
        return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in ('F', 'W') else 1 for c in s)

    def fit(s, n):
        if n <= 0:
            return ''
        if cells(s) <= n:
            return s + ' ' * (n - cells(s))
        result = ''
        for c in s:
            if cells(result + c) > n - 1:
                break
            result += c
        return result + '…' + ' ' * max(0, n - cells(result) - 1)

    def color(s, code, bold=False):
        if not sys.stdout.isatty():
            return s
        return f'\x1b[{"1;" if bold else ""}38;5;{code}m{s}\x1b[0m'

    def render(row, n):
        number, symbol, status, name = row
        prefix = f' [{number}] {symbol} '
        state = f'{status:<6}'
        rest = fit(name, max(1, n - cells(prefix) - cells(state) - 3))
        tone = {'LIVE': 118, 'PORTAL': 141, 'FUSION': 201, 'VAULT': 213, 'HELP': 177, 'FUTURE': 244}[status]
        return color(prefix, 196, True) + color(state, tone, True) + color(' │ ', 90) + color(rest, 255)

    ruler = '━' * width
    print()
    print(color(ruler, 90))
    print(color(' ☠ DEADBYTE', 196, True) + color(' // REAPER COMMAND DECK', 213, True))
    print(color(ruler, 90))
    if width >= 108:
        half = (width - 3) // 2
        for a, b in zip(left, right):
            print(render(a, half) + color(' ┃ ', 90) + render(b, width - half - 3))
    else:
        for a in left:
            print(render(a, width))
        print(color('━' * width, 90))
        for b in right:
            print(render(b, width))
    print(color(ruler, 90))
    print(color(' [00] ☠ EXIT', 196, True) + color(' // TERMINATE SESSION', 252))
    print(color(' 01–06 LIVE  •  07–10 ARCHIVES  •  11 FUSION  •  12 VAULT  •  13 HELP  •  14 DEAD ARCHIVES  •  15–16 FUTURE', 141))
    print()



