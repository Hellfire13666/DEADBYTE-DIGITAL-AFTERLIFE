import re

ROOT = pathlib.Path.home() / ".local/share/deadbyte"
ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)

COLORS = [196, 208, 226, 118, 51, 39, 129, 201]

def paint(s, n=3):
    return f"\033[38;5;{COLORS[n%8]}m{s}\033[0m" if sys.stdout.isatty() else s

def clean(s):
    return "".join(c for c in html.unescape(re.sub("<[^>]*>", "", str(s))) if c.isprintable())

def get(url, params):
    url += "?" + urllib.parse.urlencode(params, doseq=True)
    req = urllib.request.Request(url, headers={
        "User-Agent": "DEADBYTE/0.1 Public Archive Reader",
        "Accept": "application/json"
    })
    with urllib.request.urlopen(req, timeout=25) as r:
        return json.load(r)

def record(title, url, desc="", date=""):
    return dict(title=clean(title), url=clean(url),
                description=clean(desc), date=clean(date))

NAMES = [
    "Internet Archive",
    "Open Library",
    "Library of Congress",
    "Wikisource",
    "Project Gutenberg / Gutendex",
    "Historical Newspapers / LOC"
]

PORTALS = [
    ("Wayback Machine", "https://web.archive.org/"),
    ("Common Crawl", "https://index.commoncrawl.org/"),
    ("Archive-It", "https://archive-it.org/"),
    ("Europeana", "https://www.europeana.eu/")
]

def search(i, q):
    # DEADBYTE_LOC_KEYLESS_V3_7
    # DEADBYTE_NEWSPAPER_FALLBACK_V3_8
    # DEADBYTE_ARCHIVEIT_OPENSEARCH_V3_18
    if i == 9:
        import importlib.util as _db318_util
        from pathlib import Path as _db318_Path
        _db318_file = _db318_Path.home() / '.local/share/deadbyte/deadbyte_archiveit_opensearch_v318.py'
        _db318_spec = _db318_util.spec_from_file_location('deadbyte_archiveit_opensearch_v318', _db318_file)
        _db318_module = _db318_util.module_from_spec(_db318_spec)
        _db318_spec.loader.exec_module(_db318_module)
        return _db318_module.search(q)
    if i == 6:
        import importlib.util as _db38_util
        from pathlib import Path as _db38_Path
        _db38_path = _db38_Path.home() / '.local/share/deadbyte/deadbyte_newspaper_fallback_v38.py'
        _db38_spec = _db38_util.spec_from_file_location('deadbyte_newspaper_fallback_v38', _db38_path)
        _db38_mod = _db38_util.module_from_spec(_db38_spec)
        _db38_spec.loader.exec_module(_db38_mod)
        return _db38_mod.search(q)
    if i in (3, 6):
        import importlib.util as _db_util
        from pathlib import Path as _db_Path
        _db_p = _db_Path.home()/'.local/share/deadbyte/deadbyte_loc_keyless_v37.py'
        _db_spec = _db_util.spec_from_file_location('deadbyte_loc_keyless_v37', _db_p)
        _db_mod = _db_util.module_from_spec(_db_spec)
        _db_spec.loader.exec_module(_db_mod)
        return _db_mod.search(i, q)
    if i == 1:
        d = get("https://archive.org/advancedsearch.php", {
            "q": q, "output": "json", "rows": 50,
            "fl[]": ["identifier", "title", "description", "date"]
        })
        return [record(x.get("title", x["identifier"]),
            "https://archive.org/details/" + x["identifier"],
            x.get("description", ""), x.get("date", ""))
            for x in d["response"]["docs"]]

    if i == 2:
        d = get("https://openlibrary.org/search.json",
                {"q": q, "limit": 50})
        return [record(x.get("title", ""),
            "https://openlibrary.org" + x["key"],
            ", ".join(x.get("author_name", [])),
            x.get("first_publish_year", ""))
            for x in d["docs"]]

    if i in (3, 6):
        endpoint = "https://www.loc.gov/search/" if i == 3 else "https://www.loc.gov/newspapers/"
        d = get(endpoint, {"q": q, "fo": "json", "c": 50})
        return [record(x.get("title", ""), x.get("url", ""),
            x.get("description", ""), x.get("date", ""))
            for x in d.get("results", [])]

    if i == 4:
        d = get("https://en.wikisource.org/w/api.php", {
            "action": "query", "list": "search",
            "srsearch": q, "srlimit": 50, "format": "json"
        })
        return [record(x["title"],
            "https://en.wikisource.org/?curid=" + str(x["pageid"]),
            x.get("snippet", ""), x.get("timestamp", ""))
            for x in d["query"]["search"]]

    if i == 5:
        d = get("https://gutendex.com/books/", {"search": q})
        return [record(x["title"],
            "https://www.gutenberg.org/ebooks/" + str(x["id"]),
            ", ".join(a["name"] for a in x["authors"]))
            for x in d["results"]]

def run(i, q):
    print(paint("\nCONNECTING // " + NAMES[i-1], 4))
    try:
        rows = search(i, q)
    except Exception as e:
        print(paint("PROVIDER ERROR // " + clean(e), 0))
        return
    for n, x in enumerate(rows, 1):
        print(paint(f"\n[{n:03}] " + x["title"], n))
        print(x["url"])
        print(x["date"])
        print(x["description"][:600])
    stamp = datetime.datetime.now(datetime.timezone.utc)
    p = ROOT / (stamp.strftime("%Y%m%dT%H%M%S%fZ") + ".json")
    p.write_text(json.dumps({
        "source": NAMES[i-1],
        "query": q,
        "records": rows
    }, ensure_ascii=False, indent=2))
    print(paint(f"\n{len(rows)} RECORDS // FIRST PROVIDER PAGE", 3))
    print(paint("DEAD VAULT // SAVED " + p.name, 6))


