# DEADBYTE_VAULT_INDEX_V3_6
def _deadbyte_vault_index():
    """Read-only browser of prior DEADBYTE JSON research sessions."""
    import datetime as _dt
    import json as _json
    import re as _re
    from pathlib import Path as _Path
    from textwrap import shorten as _shorten

    root = _Path.home() / '.local/share/deadbyte'
    files = sorted((p for p in root.glob('*.json') if p.is_file() and not p.is_symlink()), reverse=True)
    if not files:
        print('☠ DEAD VAULT // No saved JSON sessions yet.')
        return

    def tidy(v, width=110):
        if isinstance(v, list):
            v = ', '.join(str(x) for x in v[:5])
        elif isinstance(v, dict):
            v = ', '.join(str(x) for x in list(v.values())[:4])
        s = _re.sub(r'[\x00-\x1f\x7f-\x9f\x1b]', ' ', str(v or ''))
        return _shorten(' '.join(s.split()), width=width, placeholder='…')

    def session_info(p):
        meta={'path':p, 'label':'Untitled research', 'source':'Unknown', 'count':None,
              'date':'Unknown date', 'error':'', 'data':None}
        try:
            if p.stat().st_size > 80*1024*1024:
                raise ValueError('File too large for interactive reader (80 MB max)')
            d=_json.loads(p.read_text(encoding='utf-8'))
            if not isinstance(d,dict):
                raise ValueError('JSON session is not an object')
            meta['data']=d
            meta['source']=tidy(d.get('source') or d.get('engine') or 'Research session',42)
            question=d.get('question') or d.get('query') or d.get('keyword') or ''
            if not question:
                # An older session may have the subject only inside its first record.
                rows=d.get('records') or []
                if isinstance(rows,list) and rows and isinstance(rows[0],dict):
                    question=rows[0].get('title','')
            meta['label']=tidy(question or meta['source'],85)
            records=d.get('records')
            if isinstance(records,list):
                meta['count']=len(records)
            else:
                for k in ('results','items'):
                    if isinstance(d.get(k),list):
                        meta['count']=len(d[k]); break
            val=d.get('searched_at_utc') or d.get('created_at') or d.get('timestamp') or ''
            if val:
                meta['date']=tidy(val,32)
            else:
                m=_re.match(r'(\d{4})(\d\d)(\d\d)T(\d\d)(\d\d)', p.name)
                if m:
                    meta['date']=f'{m[1]}-{m[2]}-{m[3]} {m[4]}:{m[5]} UTC'
                else:
                    meta['date']=_dt.datetime.fromtimestamp(p.stat().st_mtime,_dt.timezone.utc).strftime('%Y-%m-%d %H:%M UTC (file time)')
        except (OSError, ValueError, UnicodeError) as exc:
            meta['error']=tidy(f'{type(exc).__name__}: {exc}',90)
        return meta

    items=[session_info(p) for p in files]
    filtered=items[:]
    page=0
    per_page=10

    def listing():
        nonlocal page
        if not filtered:
            print('No sessions match your filter. Type / to show all.'); return
        page=min(page,(len(filtered)-1)//per_page)
        print('\n☠ DEAD VAULT // RESEARCH INDEX')
        print(f'SAVED SESSIONS // {len(items)}  |  SHOWING // {len(filtered)}  |  PAGE // {page+1}/{(len(filtered)-1)//per_page+1}')
        for i in range(page*per_page,min((page+1)*per_page,len(filtered))):
            x=filtered[i]
            total=('? records' if x['count'] is None else f"{x['count']} records")
            print(f"[{i+1:03}] {x['label']}")
            print(f"      {x['date']}  |  {x['source']}  |  {total}")
            if x['error']: print('      READ ERROR // '+x['error'])
        print('\n[number] OPEN  |  [N] NEXT  |  [P] PREVIOUS  |  [/] FILTER  |  [Q] EXIT')

    def open_item(x):
        print('\n'+'━'*65)
        print('☣ SESSION // '+x['label'])
        print('DATE // '+x['date'])
        print('SOURCE // '+x['source'])
        print('FILE // '+x['path'].name)
        if x['error']:
            print('READ ERROR // '+x['error']); return
        d=x['data']
        rows=d.get('records')
        if not isinstance(rows,list): rows=d.get('results',d.get('items',[]))
        if not isinstance(rows,list): rows=[]
        print('RECORDS // '+str(len(rows)))
        errs=d.get('provider_errors') or d.get('errors')
        if errs: print('PROVIDER NOTES // '+tidy(errs,220))
        print('────────────────────────────────────────────────────────────')
        if not rows:
            print('No record list in this saved session. Metadata remains available.'); return
        cursor=0
        while True:
            segment=rows[cursor:cursor+5]
            for i,r in enumerate(segment,cursor+1):
                if not isinstance(r,dict):
                    print(f'[{i:03}] '+tidy(r,140)); continue
                name=r.get('title') or r.get('name') or r.get('event_type') or 'Untitled record'
                print(f'[{i:03}] '+tidy(name,140))
                if r.get('source'): print('  SOURCE // '+tidy(r['source'],120))
                if r.get('date') or r.get('event_time'): print('  DATE // '+tidy(r.get('date') or r.get('event_time'),100))
                if r.get('url') or r.get('link'): print('  LINK // '+tidy(r.get('url') or r.get('link'),240))
                if r.get('description') or r.get('details'):
                    print('  NOTES // '+tidy(r.get('description') or r.get('details'),420))
            print(f'RECORDS // {cursor+1}-{min(cursor+5,len(rows))} of {len(rows)}')
            try: cmd=input('[N] NEXT  [P] PREVIOUS  [number] FULL DETAIL  [B] BACK > ').strip().lower()
            except (EOFError,KeyboardInterrupt): print(); return
            if cmd in ('b','q','00',''): return
            if cmd=='n': cursor=min(cursor+5,((len(rows)-1)//5)*5)
            elif cmd=='p': cursor=max(0,cursor-5)
            elif cmd.isdigit() and 1<=int(cmd)<=len(rows):
                r=rows[int(cmd)-1]
                print('\n☣ FULL SAVED RECORD // '+str(cmd))
                if isinstance(r,dict):
                    for k,v in r.items():
                        if k in ('grouped_reports','raw_records','original_records') and isinstance(v,list):
                            print(tidy(k,50).upper()+' // '+str(len(v))+' retained observations')
                        else:
                            print(tidy(k,50).upper()+' // '+tidy(v,10000))
                else: print(tidy(r,10000))
            else: print('Select N, P, B, or a saved record number.')

    listing()
    while True:
        try: cmd=input('DEAD VAULT > ').strip()
        except (EOFError,KeyboardInterrupt): print(); break
        if cmd.lower() in ('q','b','00','exit'): break
        if cmd.lower()=='n': page=min(page+1,(len(filtered)-1)//per_page if filtered else 0)
        elif cmd.lower()=='p': page=max(0,page-1)
        elif cmd=='/':
            try: term=input('FILTER // search question, source or date (blank = all) > ').strip().casefold()
            except (EOFError,KeyboardInterrupt): break
            filtered=[x for x in items if term in (x['label']+' '+x['source']+' '+x['date']+' '+x['path'].name).casefold()]
            page=0
        elif cmd.isdigit() and 1<=int(cmd)<=len(filtered): open_item(filtered[int(cmd)-1])
        else: print('Use a session number, N, P, /, or Q.')
        listing()

def main():
    while True:
        banner()
        _db2_switchboard()
        try:
            c = input(paint("\nDEADBYTE > ", 3)).strip()
        except (EOFError, KeyboardInterrupt):
            break

        if c == "00":
            break
        elif c == "12":
            _deadbyte_vault_index()
        elif c == "13":
            print("01-06: Live keyword searches")
            print("07-10: Live public archive research")
            print("11: Search all six keyword engines")
            print("12: List private local saved sessions")
            print("00: Exit")
            # DEADBYTE_PROVIDER_FIELD_GUIDE_HELP_V1
            _db_provider_field_notes()
        elif c in ("15", "16"):
            print("☠ SHADOW SLOT // Future research bay, not active yet" if c == "15" else "◆ RESERVED BAY // Future research bay, not active yet")
        elif c == "14":
            _deadbyte_sentence_hunter()
        elif c.isdigit() and 7 <= int(c) <= 10:
            _deadbyte_archive_run(int(c))
        elif c.isdigit() and (1 <= int(c) <= 6 or int(c) == 11):
            q = input("PUBLIC RESEARCH KEYWORD > ").strip()
            if q:
                for i in (range(1,7) if int(c)==11 else [int(c)]):
                    run(i, q)

if __name__ == "__main__":
    main()

